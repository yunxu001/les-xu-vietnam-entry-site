---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceCards from "../../components/ServiceCards.astro";
import { site } from "../../data/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Services", item: `${site.url}/services/` }
  ]
};
---

<BaseLayout title="Services" description="Business Lens Advisory provides practical support for SME owners across business judgement, AI systems, cross-border work, and people operations." schema={schema}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Business Lens Advisory</p>
      <h1>Support for the decision, the system, and the next move.</h1>
      <p class="lead">Les Xu and Jeffrey Zhang work remotely with SME owners across Australia, China, Vietnam, and Southeast Asia. In-person work is available by arrangement.</p>
    </div>
  </section>
  <section class="section tight">
    <div class="container"><ServiceCards /></div>
  </section>
  <section class="section">
    <div class="container boundary card">
      <h2>Practical support, with the right specialists involved.</h2>
      <p>We bring commercial, operating, and implementation perspective. Legal, tax, financial, licensing, and migration decisions should be confirmed with appropriately licensed local professionals.</p>
      <a class="button gold" href="/contact">Start an enquiry</a>
    </div>
  </section>
</BaseLayout>

<style>
  .boundary { display: grid; gap: 16px; max-width: 820px; }
  .boundary p { margin: 0; color: var(--steel); }
</style>
