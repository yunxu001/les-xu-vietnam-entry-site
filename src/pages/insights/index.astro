---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await Astro.glob("../../content/insights/*.md")).sort(
  (a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99)
);

const slugFor = (file: string) => file.split(/[\\/]/).pop()?.replace(/\.md$/, "") ?? "";
---

<BaseLayout title="Vietnam Entry Insights" description="Vietnam Entry Playbook insights from Les Xu.">
  <section class="page-hero dark-band">
    <div class="container">
      <p class="eyebrow">Insights</p>
      <h1>Vietnam Entry Playbook</h1>
      <p class="lead">
        Practical notes for founders and investors who want a calmer way to evaluate Vietnam before leases, filings, capital transfers, and partner commitments take over.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container post-grid">
      {
        posts.map((post) => (
          <a class="post-card" href={`/insights/${slugFor(post.file)}`}>
            <img src={post.frontmatter.image} alt={post.frontmatter.title} />
            <div>
              <p class="eyebrow">{post.frontmatter.category}</p>
              <h2>{post.frontmatter.title}</h2>
              <p>{post.frontmatter.description}</p>
              <span>{post.frontmatter.readTime}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 104px 0 72px;
  }

  .page-hero .container {
    display: grid;
    gap: 18px;
  }

  .post-grid {
    display: grid;
    gap: 24px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 250, 240, 0.72);
  }

  .post-card img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .post-card div {
    display: grid;
    gap: 12px;
    padding: 26px 26px 26px 0;
  }

  .post-card h2 {
    font-size: clamp(1.8rem, 3vw, 3rem);
  }

  .post-card p {
    color: var(--steel);
  }

  .post-card span {
    color: var(--red);
    font-weight: 900;
  }

  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: 1fr;
    }

    .post-card div {
      padding: 24px;
    }
  }
</style>
