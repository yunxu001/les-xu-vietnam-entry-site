---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("insights")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const slugFor = (id: string) => id.replace(/\.md$/, "");
---

<BaseLayout title="Business Lens Library" description="Business Lens articles about SME judgement, practical AI, cross-border work, and people operations.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Insights</p>
      <h1>Business Lens Library</h1>
      <p class="lead">
        Practical notes for owners building, improving, or expanding across Australia, China, Vietnam, and Southeast Asia.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container post-grid">
      {
        posts.map((post) => (
          <a class="post-card" href={`/insights/${slugFor(post.id)}`}>
            <img src={post.data.image} alt={post.data.title} />
            <div>
              <p class="eyebrow">{post.data.category}</p>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span>{post.data.readTime}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 104px 0 72px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .page-hero .container {
    display: grid;
    gap: 18px;
  }

  .post-grid {
    display: grid;
    gap: 24px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 28px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 250, 240, 0.72);
  }

  .post-card img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .post-card div {
    display: grid;
    gap: 12px;
    padding: 26px 26px 26px 0;
  }

  .post-card h2 {
    font-size: clamp(1.8rem, 3vw, 3rem);
  }

  .post-card p {
    color: var(--steel);
  }

  .post-card span {
    color: var(--red);
    font-weight: 900;
  }

  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: 1fr;
    }

    .post-card div {
      padding: 24px;
    }
  }
</style>
