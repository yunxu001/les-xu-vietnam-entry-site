---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("insights");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image}>
  <section class="article-hero dark-band">
    <div class="container article-hero-grid">
      <div>
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <span>{post.data.readTime}</span>
      </div>
      <div class="media-frame">
        <img src={post.data.image} alt={post.data.title} />
      </div>
    </div>
  </section>

  <article class="article-body">
    <Content />
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .article-hero {
    padding: 96px 0 72px;
  }

  .article-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  .article-hero span {
    color: var(--gold);
    font-weight: 900;
  }

  @media (max-width: 860px) {
    .article-hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
