---
import BaseLayout from "../layouts/BaseLayout.astro";
import youtubeFeed from "../../content-output/youtube-feed.json";
import { featuredMedia, socialLinks, site } from "../data/site";

type Video = {
  id: string;
  title: string;
  url: string;
  thumbnail: string;
  publishedAt: string;
  updatedAt?: string;
};

const videos = youtubeFeed.entries as Video[];
const formattedDate = (date: string) => new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "short",
  year: "numeric"
}).format(new Date(date));

const schema = videos.map((video) => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: video.title,
  description: `Business Lens with Les video: ${video.title}`,
  thumbnailUrl: video.thumbnail,
  uploadDate: video.publishedAt,
  contentUrl: video.url,
  embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
  publisher: { "@type": "Organization", name: site.name, url: site.url }
}));
---

<BaseLayout title="Watch" description="Business Lens with Les videos and commentary for SME owners." schema={schema}>
  <section class="section watch-hero">
    <div class="container">
      <p class="eyebrow">Business Lens with Les</p>
      <h1>Ideas worth taking into the next meeting.</h1>
      <p class="lead">Practical commentary on business judgement, AI, cross-border work, and the operating systems behind a calmer business.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="container featured-layout">
      <div>
        <p class="eyebrow">Featured video</p>
        <h2>{featuredMedia.title}</h2>
        <p class="lead">{featuredMedia.description}</p>
        <a class="text-link" href={featuredMedia.watchUrl} target="_blank" rel="noreferrer">Watch on YouTube -></a>
      </div>
      <div class="media-frame video-frame">
        <iframe src={featuredMedia.embedUrl} title={featuredMedia.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="section library-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Video library</p>
          <h2>Latest from the channel.</h2>
        </div>
        <a class="text-link" href="https://www.youtube.com/@BusinessLenswithLes" target="_blank" rel="noreferrer">Open YouTube channel -></a>
      </div>
      {videos.length > 0 ? (
        <div class="video-grid">
          {videos.map((video) => (
            <article class="video-card">
              <a class="thumbnail" href={video.url} target="_blank" rel="noreferrer" aria-label={`Watch ${video.title} on YouTube`}>
                <img src={video.thumbnail} alt="" loading="lazy" />
                <span aria-hidden="true">Play</span>
              </a>
              <div>
                <p class="date">{formattedDate(video.publishedAt)}</p>
                <h3><a href={video.url} target="_blank" rel="noreferrer">{video.title}</a></h3>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <article class="card empty-state">
          <h3>The library is being refreshed.</h3>
          <p>Visit the YouTube channel for the latest Business Lens videos.</p>
        </article>
      )}
      <p class="refresh-note">New uploads are checked automatically. The featured video above is selected separately, so it stays intentional.</p>
    </div>
  </section>

  <section class="section dark-band">
    <div class="container follow-layout">
      <div><p class="eyebrow">Follow the work</p><h2>Choose the channel that fits your week.</h2></div>
      <div class="socials">{socialLinks.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.name}</a>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .watch-hero { padding-bottom: 48px; }
  .featured-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center; }
  .video-frame { aspect-ratio: 16 / 9; }
  iframe { width: 100%; height: 100%; border: 0; }
  .text-link { color: var(--red); font-weight: 900; }
  .library-section { border-top: 1px solid var(--line); }
  .section-heading, .follow-layout { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 28px; }
  .section-heading p, .section-heading h2 { margin: 0; }
  .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .video-card { overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: var(--white); }
  .thumbnail { position: relative; display: grid; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ink); }
  .thumbnail img { width: 100%; height: 100%; object-fit: cover; transition: transform 180ms ease; }
  .thumbnail:hover img { transform: scale(1.03); }
  .thumbnail span { position: absolute; right: 12px; bottom: 12px; border-radius: 3px; padding: 6px 8px; background: var(--ink); color: var(--paper); font-size: 0.75rem; font-weight: 900; }
  .video-card > div { display: grid; gap: 8px; padding: 16px; }
  .video-card h3 { font-size: 1.08rem; }
  .date { margin: 0; color: var(--red); font-family: Consolas, monospace; font-size: 0.76rem; font-weight: 800; text-transform: uppercase; }
  .empty-state { max-width: 600px; }
  .empty-state p, .refresh-note { color: var(--muted); }
  .refresh-note { margin-top: 20px; font-size: 0.85rem; }
  .follow-layout { margin-bottom: 0; }
  .socials { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; }
  .socials a { border-bottom: 1px solid var(--gold); color: var(--paper); font-weight: 800; }
  @media (max-width: 860px) {
    .featured-layout, .video-grid { grid-template-columns: 1fr; }
    .section-heading, .follow-layout { display: grid; align-items: start; }
    .socials { justify-content: flex-start; }
  }
</style>
