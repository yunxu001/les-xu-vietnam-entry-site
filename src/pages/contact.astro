---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactMethods from "../components/ContactMethods.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact Les Xu" description="Contact Les Xu for Vietnam entry and owner-independent operations advisory.">
  <section class="contact-hero">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Send the decision you are trying to make next.</h1>
        <p class="lead">
          Scan WhatsApp, WeChat, or Zalo and send the business activity, target city or province, current stage, and the commitment you are considering.
        </p>
        <div class="button-row">
          <a class="button" href="#qr-codes">{site.primaryCta}</a>
          <a class="button secondary light" href="/resources/vietnam-entry-decision-gate-checklist">{site.secondaryCta}</a>
        </div>
      </div>
      <div class="contact-card">
        <p class="eyebrow">Useful message format</p>
        <ul>
          <li>What business activity are you evaluating?</li>
          <li>Are you exploring, negotiating, or already operating?</li>
          <li>Which decision feels expensive if wrong?</li>
          <li>Who else is already involved?</li>
          <li>What do you need within the next 30 days?</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="qr-codes" class="section tight">
    <div class="container section-heading">
      <p class="eyebrow">Choose a channel</p>
      <h2>WhatsApp, WeChat, and Zalo QR codes.</h2>
    </div>
    <div class="container">
      <ContactMethods />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    min-height: 620px;
    display: grid;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 96px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.75fr;
    gap: 48px;
    align-items: center;
  }

  .contact-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px;
    background: var(--white);
  }

  li {
    margin-bottom: 10px;
    color: var(--steel);
  }

  .light {
    color: var(--ink);
  }

  .section-heading {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
