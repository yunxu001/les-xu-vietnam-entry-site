---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import FAQ from "../components/FAQ.astro";
import OfferCards from "../components/OfferCards.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import { site } from "../data/site";
---

<BaseLayout title="Advisory Offers" description="Productized Vietnam entry and owner-independent operations advisory offers from Les Xu.">
  <section class="page-hero">
    <div class="container split">
      <div>
        <p class="eyebrow">Advisory</p>
        <h1>Practical help before the expensive decisions.</h1>
      </div>
      <p class="lead">
        The offers are built for foreign founders, SME owners, private investors, and operators who need clear sequencing before Vietnam turns into a moving project.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <OfferCards />
    </div>
  </section>

  <section class="section method-section">
    <div class="container section-heading">
      <p class="eyebrow">How the work runs</p>
      <h2>A simple sequence, not a giant consulting theatre.</h2>
    </div>
    <div class="container">
      <ProcessSteps />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Boundaries</p>
        <h2>Clear advice, careful claims.</h2>
      </div>
      <div>
        <p class="lead">
          Les does not replace licensed local legal, tax, banking, immigration, accounting, or investment advisers.
        </p>
        <p>
          The work is to help you ask better questions, avoid weak sequencing, coordinate the right specialists, and turn scattered information into a practical operating plan.
        </p>
        <a class="button" href="/contact">{site.primaryCta}</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container section-heading">
      <p class="eyebrow">Common questions</p>
      <h2>What to know before you book.</h2>
    </div>
    <div class="container">
      <FAQ />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .page-hero {
    padding: 104px 0 72px;
    background: var(--paper);
  }

  .method-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #ffffff;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 52px;
    align-items: end;
  }

  .section-heading {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
