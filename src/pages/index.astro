---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import ContactMethods from "../components/ContactMethods.astro";
import InsightCards from "../components/InsightCards.astro";
import OfferCards from "../components/OfferCards.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ProofStrip from "../components/ProofStrip.astro";
import { site } from "../data/site";
---

<BaseLayout title="Vietnam Entry Advisory" description={site.description}>
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">Les Xu / Vietnam Entry Advisory</p>
      <h1>Build the Vietnam plan before the Vietnam project builds you.</h1>
      <p class="lead">
        {site.description} Start with the decision sequence: activity, access, site, partners, capital path, and the first 100 days of control.
      </p>
      <div class="button-row">
        <a class="button" href="/contact">{site.primaryCta}</a>
        <a class="button secondary" href="/insights">Read the playbook</a>
      </div>
      <div class="hero-note">
        <span>For foreign founders, SME owners, private investors, and China plus one operators.</span>
      </div>
    </div>
  </section>

  <ProofStrip />

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Point of view</p>
        <h2>Vietnam is attractive. It is not automatic.</h2>
      </div>
      <div>
        <p class="lead">
          Many first-time entrants start with the visible question: company setup, rent, labour, a local agent, a cheap factory, or a promising introduction.
        </p>
        <p>
          Les starts earlier: what activity are you really doing, which gates need confirmation, what location fits the operating model, how will capital move, who owns each approval, and what system keeps the owner out of the daily mess?
        </p>
      </div>
    </div>
  </section>

  <section class="section service-section">
    <div class="container section-heading">
      <p class="eyebrow">Productized advisory</p>
      <h2>Four simple ways to turn uncertainty into a decision sequence.</h2>
    </div>
    <div class="container">
      <OfferCards />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Operating method</p>
        <h2>Decision gates before action lists.</h2>
      </div>
      <p class="lead">
        The work is practical: narrow the activity, expose the gates, sequence the first moves, then build enough operating control that the business does not depend on daily owner heroics.
      </p>
    </div>
    <div class="container">
      <ProcessSteps />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Scan, add, and send the decision you are trying to make.</h2>
        <p class="lead">
          No public social-profile detour. Use WhatsApp, WeChat, or Zalo and include the business activity, target location, current stage, and what feels expensive if wrong.
        </p>
      </div>
      <ContactMethods />
    </div>
  </section>

  <section class="section tight">
    <div class="container section-heading">
      <p class="eyebrow">Latest thinking</p>
      <h2>Start with the gates most founders underestimate.</h2>
    </div>
    <div class="container">
      <InsightCards />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    min-height: 680px;
    display: grid;
    align-items: center;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    padding: 96px 0 80px;
  }

  .hero-content {
    display: grid;
    gap: 22px;
  }

  .hero-note {
    max-width: 680px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
    color: var(--muted);
    font-weight: 700;
  }

  .split,
  .section-heading {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
  }

  .service-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #ffffff;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding: 72px 0;
    }

    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
