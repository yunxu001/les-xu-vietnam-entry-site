---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import ServiceCards from "../components/ServiceCards.astro";
import { featuredMedia, founders, site } from "../data/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description
};
---

<BaseLayout title={site.title} description={site.description} schema={schema}>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Business Lens with Les</p>
      <h1>Practical business judgement for owners building, improving, or expanding across Australia, China, Vietnam, and Southeast Asia.</h1>
      <p class="lead">Ideas for the work. Advisory for the decisions behind it. Built by Les Xu and Jeffrey Zhang for SME owners who want a business that can move without them carrying every detail.</p>
      <div class="button-row">
        <a class="button gold" href="/brief">{site.primaryCta}</a>
        <a class="button secondary" href="/services">{site.secondaryCta}</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container media-layout">
      <div>
        <p class="eyebrow">Featured commentary</p>
        <h2>{featuredMedia.title}</h2>
        <p class="lead">{featuredMedia.description}</p>
        <a class="text-link" href="/watch">Watch the Business Lens series -></a>
      </div>
      <div class="media-frame video-frame">
        <iframe src={featuredMedia.embedUrl} title={featuredMedia.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Business Lens Advisory</p>
      <h2>Useful support when the next decision matters.</h2>
      <ServiceCards />
    </div>
  </section>

  <section class="section dark-band">
    <div class="container founder-layout">
      <div>
        <p class="eyebrow">Two founders</p>
        <h2>Commercial judgement and people systems, together.</h2>
      </div>
      <div class="grid two">
        {founders.map((founder) => (
          <article>
            <h3>{founder.name}</h3>
            <p>{founder.shortBio}</p>
          </article>
        ))}
      </div>
      <a class="button gold" href="/team">Meet Les and Jeffrey</a>
    </div>
  </section>

  <section class="section">
    <div class="container brief-layout">
      <div>
        <p class="eyebrow">The Business Lens Brief</p>
        <h2>A useful note, every two weeks.</h2>
        <p class="lead">Business judgement, practical AI, cross-border execution, and the operating habits that give owners room to think.</p>
      </div>
      <NewsletterForm source="homepage" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 82px 0 70px;
  }

  .hero .lead {
    margin: 28px 0;
  }

  .hero h1 {
    max-width: 920px;
    font-size: clamp(2.6rem, 4.5vw, 4rem);
  }

  .media-layout,
  .brief-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .video-frame {
    aspect-ratio: 16 / 9;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .text-link {
    color: var(--red);
    font-weight: 900;
  }

  .founder-layout {
    display: grid;
    grid-template-columns: 0.75fr 1.4fr auto;
    gap: 32px;
    align-items: end;
  }

  .founder-layout article h3 {
    font-size: 1.1rem;
  }

  .founder-layout article p {
    margin-bottom: 0;
    font-size: 0.94rem;
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 72px;
    }

    .hero h1 {
      font-size: clamp(2.55rem, 10.5vw, 3.2rem);
      line-height: 0.98;
    }

    .media-layout,
    .brief-layout,
    .founder-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
