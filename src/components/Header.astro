---
import { site } from "../data/site";

const nav = [
  { href: "/services", label: "Services" },
  { href: "/watch", label: "Watch" },
  { href: "/insights", label: "Insights" },
  { href: "/brief", label: "Brief" },
  { href: "/team", label: "Team" },
  { href: "/contact", label: "Contact" }
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <span>{site.name}</span>
    <small>Business judgement, systems, and cross-border execution</small>
  </a>
  <nav aria-label="Primary navigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="header-cta" href="/brief">{site.primaryCta}</a>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 14px 24px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    background: rgba(247, 244, 239, 0.96);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: grid;
    gap: 2px;
    font-weight: 900;
  }

  .brand span {
    font-size: 1.05rem;
  }

  .brand small {
    color: var(--muted);
    font-family: "IBM Plex Mono", Consolas, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    color: var(--steel);
    font-size: 0.92rem;
    font-weight: 700;
  }

  nav a:hover,
  .brand:hover {
    color: var(--red);
  }

  .header-cta {
    border: 1px solid var(--ink);
    border-radius: 4px;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.88rem;
    font-weight: 800;
  }

  @media (max-width: 980px) {
    .site-header {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    nav {
      justify-content: flex-start;
    }

    .header-cta {
      display: none;
    }

    .brand small,
    nav a[href="/insights"],
    nav a[href="/team"] {
      display: none;
    }
  }
</style>
