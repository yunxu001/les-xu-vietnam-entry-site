---
import { insightLinks } from "../data/site";
---

<div class="grid three insight-grid">
  {
    insightLinks.map((item) => (
      <a class="insight-card card" href={`/insights/${item.slug}`}>
        <span>{item.category}</span>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <strong>Read insight</strong>
      </a>
    ))
  }
</div>

<style>
  .insight-card {
    display: grid;
    gap: 12px;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .insight-card:hover {
    border-color: var(--red);
    transform: translateY(-2px);
  }

  span {
    color: var(--green);
    font-family: "IBM Plex Mono", Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  p {
    color: var(--steel);
  }

  strong {
    color: var(--red);
  }
</style>
