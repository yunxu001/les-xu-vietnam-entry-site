---
import { faqs } from "../data/site";
---

<div class="faq-list">
  {
    faqs.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    display: grid;
    gap: 10px;
  }

  details {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 250, 240, 0.64);
    padding: 18px 20px;
  }

  summary {
    cursor: pointer;
    color: var(--ink);
    font-weight: 900;
  }

  p {
    margin-bottom: 0;
    color: var(--steel);
  }
</style>
